# ──────────────────────────────────────────────
# .env  →  "Environment Variables" file
#
# WHY THIS FILE EXISTS:
#   You don't want secret values (passwords, keys)
#   written directly inside your code.
#   Instead, put them here and read them with
#   process.env.VARIABLE_NAME in your JS files.
#
# ⚠️  NEVER push this file to GitHub.
#     Add ".env" to your .gitignore file.
# ──────────────────────────────────────────────

# MongoDB connection string
# mongodb://localhost:27017  →  local MongoDB on your machine
# /tododb                    →  name of the database (auto-created)
MONGO_URI=mongodb+srv://me:Abcd%401234@backend-learning.jvsweps.mongodb.net/project0

# JWT Secret Key
# This is used to SIGN and VERIFY tokens.
# It can be any random string — just keep it secret.
# If someone knows this, they can forge tokens.
JWT_SECRET=my_todo_secret_key_123
