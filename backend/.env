# .env file — Environment Variables
# 
# What is .env?
# A file to store SECRET values that you DON'T want in your code
# (Don't push this to GitHub!)
#
# process.env.MONGO_URI → reads the value from here

# Your MongoDB connection string
# If using local MongoDB: mongodb://localhost:27017/placementdb
# If using MongoDB Atlas (cloud): paste your connection string here
MONGO_URI=mongodb://localhost:27017/placementdb

# Secret key used to sign JWT tokens
# This can be ANY random string — just keep it secret
JWT_SECRET=my_super_secret_key_change_this_in_production
